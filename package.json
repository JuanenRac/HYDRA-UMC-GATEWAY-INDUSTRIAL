{
  "name": "hydra-umc-gateway-industrial",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Industry 4.0 interoperability bridge - aggregates HYDRA-UMC-OPCUA-SERVER, HYDRA-UMC-MQTT-BROKER and HYDRA-UMC-MTCONNECT-ADAPTER behind a single status/health surface for factory PLCs, SCADA and IIoT platforms.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/healthcheck.ts --bundle --platform=node --format=cjs --outfile=dist/healthcheck.cjs",
    "build": "npm run bundle",
    "smoke": "node scripts/smoke.mjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
