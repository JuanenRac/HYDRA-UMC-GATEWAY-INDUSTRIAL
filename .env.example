# Copy to .env only when the process manager or container loads dotenv-style
# files. systemd may instead declare the same values with Environment=.

# Gateway HTTP port (default: 8000)
PORT=8000

# Real TLS/mTLS (src/tls.ts) - all optional, unset by default (plain HTTP,
# fine for local development or a trusted-LAN deployment behind its own
# reverse proxy). Setting TLS_CERT_PATH+TLS_KEY_PATH switches the gateway
# to real HTTPS; additionally setting TLS_CLIENT_CA_PATH turns that into
# real mutual TLS - every client must then present a certificate signed
# by that CA, or the TLS handshake itself is refused before any request
# is even parsed. A misconfigured path (set but unreadable) is a real
# startup error, never a silent fall-back to plaintext HTTP.
#TLS_CERT_PATH=/etc/hydra-umc/gateway-industrial/server.crt
#TLS_KEY_PATH=/etc/hydra-umc/gateway-industrial/server.key
#TLS_CLIENT_CA_PATH=/etc/hydra-umc/gateway-industrial/ca.crt

# Real per-command caller authentication (src/auth.ts). Set this to require a valid
# HS256 Authorization: Bearer <token> signed with this same secret on every POST /command.
# docker-compose.yml REQUIRES it (and so does any NODE_ENV=production start): the gateway
# refuses to start without a secret of at least 32 characters that is not an example value
# (generate one with `openssl rand -hex 32`). Outside production, unset means that route has
# no caller authentication beyond the allowlist itself.
#GATEWAY_JWT_SECRET=

# Says, on purpose, that a production gateway is an open lab gateway (no caller authentication).
#GATEWAY_ALLOW_ANONYMOUS=1

# The interface the gateway binds to (default: every interface).
#GATEWAY_BIND_HOST=0.0.0.0

# The topics an MQTT "publish" command may target: comma-separated MQTT filters. Default:
# hydra/gateway/#. The bridges' own command topics (hydra/bridges/...) and $SYS are never
# reachable through the gateway, whatever is set here.
#GATEWAY_MQTT_PUBLISH_TOPICS=hydra/gateway/#

# docker-compose.yml also needs the MQTT broker's credentials and ACL (the broker refuses a
# production start without them). Each credential's clientIdPrefix is the identity its ACL
# rule is evaluated for; the bridges connect with HYDRA_MQTT_USERNAME/HYDRA_MQTT_PASSWORD of
# their credential (see HYDRA-UMC-SDK's docs/BRIDGE_CONTRACT.md). Passwords: 16+ characters.
#MQTT_AUTH_JSON=[{"username":"hydra-umc-bridge-cnc","password":"<random 16+ characters>","clientIdPrefix":"hydra-umc-bridge-cnc"}]
#MQTT_ACL_JSON=[{"clientIdPrefix":"hydra-umc-bridge-cnc","publish":["hydra/bridges/cnc/#"],"subscribe":["hydra/bridges/cnc/cmd/#"]}]

# Health-probe timeout in milliseconds (default: 2000)
PROBE_TIMEOUT_MS=2000

# Child service endpoints for a CM5/local deployment.
OPCUA_HOST=opcua-server
OPCUA_PORT=4840
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MTCONNECT_URL=http://mtconnect-adapter:5000/probe
