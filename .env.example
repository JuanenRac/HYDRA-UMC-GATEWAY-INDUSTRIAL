# =============================================================================
# Copy to .env only when the process manager or container loads dotenv-style
# files. systemd may instead declare the same values with Environment=.

# Gateway HTTP port (default: 8000)
PORT=8000

# Real TLS/mTLS (src/tls.ts) - all optional, unset by default (plain HTTP,
# fine for local development or a trusted-LAN deployment behind its own
# reverse proxy). Setting TLS_CERT_PATH+TLS_KEY_PATH switches the gateway
# to real HTTPS; additionally setting TLS_CLIENT_CA_PATH turns that into
# real mutual TLS - every client must then present a certificate signed
# by that CA, or the TLS handshake itself is refused before any request
# is even parsed. A misconfigured path (set but unreadable) is a real
# startup error, never a silent fall-back to plaintext HTTP.
#TLS_CERT_PATH=/etc/hydra-umc/gateway-industrial/server.crt
#TLS_KEY_PATH=/etc/hydra-umc/gateway-industrial/server.key
#TLS_CLIENT_CA_PATH=/etc/hydra-umc/gateway-industrial/ca.crt

# Real per-command caller authentication (src/auth.ts). Set this to require a valid
# HS256 Authorization: Bearer <token> signed with this same secret on every POST /command.
# The gateway refuses to start, in ANY environment, without a secret of at least 32 characters
# that is not an example value (generate one with `openssl rand -hex 32`); docker-compose.yml
# requires it too. A token must carry `exp` and `sub`.
#GATEWAY_JWT_SECRET=

# When set, a token must also carry this `aud`, so a token minted for another service that
# shares the secret is not accepted here.
#GATEWAY_JWT_AUDIENCE=hydra-umc-gateway-industrial

# Says, on purpose, that this is an open lab gateway (no caller authentication), so it starts
# without a secret. Only for a loopback or lab network.
#GATEWAY_ALLOW_ANONYMOUS=1

# The interface the gateway binds to (default: 127.0.0.1; the container image sets 0.0.0.0).
#GATEWAY_BIND_HOST=127.0.0.1

# What GET /status checks: "tcp" (default) opens a TCP connection to OPC-UA and MQTT and GETs the
# MTConnect URL; "protocol" says the first words of each protocol (an OPC UA Hello that must be
# acknowledged, an MQTT CONNECT that must be answered, an MTConnectDevices document).
#GATEWAY_PROBE_MODE=protocol
# The account the MQTT probe uses in protocol mode (a broker with authentication needs one).
#GATEWAY_MQTT_PROBE_USERNAME=
#GATEWAY_MQTT_PROBE_PASSWORD=
#GATEWAY_MQTT_PROBE_CLIENT_ID=

# Opt-in checks and controls (all off unless set to 1, except the list):
# check that a command target is a NodeId / an agent path
#GATEWAY_STRICT_TARGETS=1
# refuse an Authorization header over plain HTTP from another machine
#GATEWAY_REQUIRE_TLS_FOR_AUTH=1
# serve GET /metrics (Prometheus text format)
#GATEWAY_METRICS=1
# with mutual TLS: client certificates whose CN is listed may command without a token
#GATEWAY_CERT_ALLOWED_CN=scada-1,plc-2

# How long a GET /status answer is reused, in milliseconds (default 1500): every uncached call
# opens a connection to each child.
#GATEWAY_STATUS_CACHE_MS=1500

# The topics an MQTT "publish" command may target: comma-separated MQTT filters. Default:
# hydra/gateway/#. The bridges' own command topics (hydra/bridges/...) and $SYS are never
# reachable through the gateway, whatever is set here.
#GATEWAY_MQTT_PUBLISH_TOPICS=hydra/gateway/#

# docker-compose.yml also needs the MQTT broker's credentials and ACL (the broker refuses a
# production start without them). Each credential's clientIdPrefix is the identity its ACL
# rule is evaluated for; the bridges connect with HYDRA_MQTT_USERNAME/HYDRA_MQTT_PASSWORD of
# their credential (see HYDRA-UMC-SDK's docs/BRIDGE_CONTRACT.md). Passwords: 16+ characters.
#MQTT_AUTH_JSON=[{"username":"hydra-umc-bridge-cnc","password":"<random 16+ characters>","clientIdPrefix":"hydra-umc-bridge-cnc"}]
#MQTT_ACL_JSON=[{"clientIdPrefix":"hydra-umc-bridge-cnc","publish":["hydra/bridges/cnc/#"],"subscribe":["hydra/bridges/cnc/cmd/#"]}]

# Health-probe timeout in milliseconds (default: 2000)
PROBE_TIMEOUT_MS=2000

# Child service endpoints for a CM5/local deployment.
OPCUA_HOST=opcua-server
OPCUA_PORT=4840
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MTCONNECT_URL=http://mtconnect-adapter:5000/probe

# Passed through by docker-compose.yml to the services it starts; all optional.
# OPC-UA server: the one account that may write, how clients are trusted, and the roster source.
#OPCUA_ADMIN_USERNAME=hydra-admin
#OPCUA_ADMIN_PASSWORD=<random 16+ characters>
#OPCUA_AUTO_ACCEPT=1
#OPCUA_ALTERNATE_HOSTNAME=opcua.plant.example
#HYDRA_SERVER_URL=http://host.docker.internal:3000
#HYDRA_SERVER_USER=operator
#HYDRA_SERVER_PASSWORD=<password>
# MTConnect adapter: without a machine source every DataItem is UNAVAILABLE.
#HYDRA_UMC_SERVER_URL=http://host.docker.internal:3000
#HYDRA_UMC_SERVER_USER=operator
#HYDRA_UMC_SERVER_PASSWORD=<password>
#HYDRA_UMC_ROBOT_ID=1
